  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" Condition="'$(_ZVcpkgRoot)'==''" />
  <Target Name="StarterData" AfterTargets="Build" Condition="'$(StarterMode)'!='Probe'">
    <!-- Never overwrite an edited runtime list during a rebuild. -->
    <Copy SourceFiles="$(ProjectDir)programme.txt" DestinationFolder="$(OutDir)" Condition="!Exists('$(OutDir)programme.txt')" />
    <MakeDir Directories="$(OutDir)share\glib-2.0\schemas" />
    <Exec Command="&quot;$(GtkPrefix)\tools\glib\glib-compile-schemas.exe&quot; --strict --targetdir=&quot;$(OutDir)share\glib-2.0\schemas&quot; &quot;$(GtkPrefix)\share\glib-2.0\schemas&quot;" />
  </Target>
