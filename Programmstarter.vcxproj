      <PreprocessorDefinitions>UNICODE;_UNICODE;_CRT_SECURE_NO_WARNINGS;GRAPHENE_HAS_SSE2;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(GtkPrefix)\include\gtk-4.0;$(GtkPrefix)\include\glib-2.0;$(GtkPrefix)\lib\glib-2.0\include;$(GtkPrefix)\include\pango-1.0;$(GtkPrefix)\include\cairo;$(GtkPrefix)\include\gdk-pixbuf-2.0;$(GtkPrefix)\include\graphene-1.0;$(GtkPrefix)\lib\graphene-1.0\include;$(GtkPrefix)\include\harfbuzz;$(GtkPrefix)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
