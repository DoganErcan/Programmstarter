      <AdditionalDependencies>gtk-4.lib;glib-2.0.lib;gobject-2.0.lib;gio-2.0.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="programmstarter.c" Condition="'$(StarterMode)'=='App'" />
    <ClCompile Include="tests\starter_tests.c" Condition="'$(StarterMode)'=='Test'" />
    <ClCompile Include="tests\probe.c" Condition="'$(StarterMode)'=='Probe'" />
    <None Include=".gitignore" />
    <None Include="programme.txt" />
    <None Include="README.md" />
